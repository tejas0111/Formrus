# Sui network: "testnet" or "mainnet"
VITE_SUI_NETWORK=mainnet

# Walrus endpoints (no trailing slash)
VITE_WALRUS_PUBLISHER_URL=
VITE_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-mainnet.walrus.space

# Number of Walrus epochs to store blobs (default: 5)
VITE_WALRUS_EPOCHS=5

# Formrus on-chain package and registry object on Sui mainnet
VITE_FORMRUS_PACKAGE_ID=
# Comma-separated list of previous package IDs to scan for forms in the dashboard
VITE_FORMRUS_LEGACY_PACKAGE_IDS=
VITE_FORMRUS_REGISTRY_ID=

# Seal encryption key servers (comma-separated object IDs)
VITE_SEAL_KEY_SERVER_IDS=
VITE_SEAL_THRESHOLD=2

# Seal session key TTL in minutes (default: 10)
VITE_SEAL_SESSION_TTL_MIN=10
